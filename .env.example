# Required for run_mt_bench.py (MT-Bench multi-turn benchmark)
OPENAI_API_KEY=sk-...

# Optional: model to use (default: gpt-4o-mini)
# MT_BENCH_MODEL=gpt-4o

# For run_mt_bench_cursor_cloud.py (Cursor Cloud Agents API — Beta, all plans)
# Create key: Cursor Dashboard → Integrations
# CURSOR_API_KEY=...
# CURSOR_AGENT_REPO=https://github.com/your-username/ComposerSpeedTest
# CURSOR_AGENT_MODEL=default

# Existing (LangSmith)
TRACE_TO_LANGSMITH=true
LANGCHAIN_API_KEY=...
LANGCHAIN_PROJECT="Composer Project"
